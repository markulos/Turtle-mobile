{
  "expo": {
    "name": "TURTLE-APP",
    "slug": "password-task-manager",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "turtle",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.markulos.passwordtaskmanager",
      "infoPlist": {
        "NSFaceIDUsageDescription": "This app uses Face ID to securely unlock your passwords.",
        "NSBiometricUsageDescription": "This app uses biometric authentication to protect your passwords.",
        "NSContactsUsageDescription": "Turtle uses your contacts so you can invite friends to your pond by picking them from your phone.",
        "NSLocalNetworkUsageDescription": "Turtle connects to your own Turtle server (and, in development, the Metro bundler) on your local network or private VPN.",
        "NSBonjourServices": [
          "_http._tcp",
          "_exp._tcp",
          "_expo._tcp"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSSupportsLiveActivities": true,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.markulos.passwordtaskmanager",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to unlock your passwords."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Turtle needs access to your photos so you can pick and upload them to your vault.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Turtle needs access to your photo library to back up and sync your camera roll.",
          "savePhotosPermission": "Turtle needs permission to save and manage photos in your library."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow $(PRODUCT_NAME) to access your contacts so you can invite friends by phone."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Turtle needs the camera to scan a desktop sign-in QR code."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 30,
            "NSExtensionActivationSupportsMovieWithMaxCount": 5,
            "NSExtensionActivationSupportsFileWithMaxCount": 5
          },
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "video/*",
            "audio/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*",
            "audio/*"
          ],
          "iosShareExtensionName": "Send to Turtle"
        }
      ],
      "expo-live-activity"
    ],
    "experiments": {
      "tsconfigPaths": false
    },
    "extra": {
      "eas": {
        "projectId": "d7ce39a1-915a-4ee7-990a-6066708faa03"
      }
    }
  }
}
