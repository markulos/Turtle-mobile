node_modules/
.expo/

# CNG / Prebuild: native projects are generated in the cloud from app.json —
# never commit local prebuild artifacts (they'd override app.json config).
/android
/ios

# Isolated feature workspaces
/.worktrees/

# Environment variables.
# `.env*` not just `.env`: a hand-made backup (.env.bak, .env.2026-08-09) carries
# the same secrets as the real thing. The example file holds only empty keys.
.env*
!.env.example

# expo export output (publishes go through the pond, never committed)
dist/
