# Mobile dev shortcuts. Copy to `.env` and fill in YOUR pond's addresses.
#
# All of these are DEV-ONLY (`__DEV__` guarded) and read at build time by Expo.
# A release build ships none of them: a shipped default host would point every
# install at one particular person's server. Real builds find a pond via a
# remembered pond, discovery (LAN sweep + funnel walk), or an invite link —
# which carries its own server address.
#
# Restart Metro after changing these; EXPO_PUBLIC_* values are inlined at
# bundle time, not read at runtime.

# Where a fresh install points before anything is saved. Bare host, host:port,
# or a full URL — all three normalise (see context/ServerContext.js serverOrigin).
EXPO_PUBLIC_TURTLE_DEV_HOST=

# Public HTTPS pond addresses to walk when confirming which pond invited a
# phone number. Comma-separated.
EXPO_PUBLIC_TURTLE_SEED_FUNNELS=

# One-tap chips on the login screen's server field.
# Format: "Label=host,Label=host"
# e.g.    Funnel=https://my-box.tailnet.ts.net,Home Wi-Fi=192.168.1.50
EXPO_PUBLIC_TURTLE_PRESETS=
